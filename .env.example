# ---------------------------------------------------------------------------
# Template for .env — copy to `.env` and fill in your own Firebase values:
#
#   flutterfire configure        # then copy the printed values in here
#
# Values here are bundled into the app, so keep them limited to *public*
# client identifiers. Never put service accounts or payment secret keys here.
# ---------------------------------------------------------------------------

APP_NAME=Your Shop
APP_ENV=development

# Locale
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en

# Storefront
CURRENCY_CODE=USD
SUPPORT_EMAIL=support@example.com

# Comma-separated e-mails allowed to open the /admin dashboard.
ADMIN_ALLOWED_EMAILS=owner@example.com

# Firebase emulator (optional)
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099

# --- Firebase: shared -------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

# --- Firebase: web ----------------------------------------------------------
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# --- Firebase: android ------------------------------------------------------
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# --- Firebase: ios / macos --------------------------------------------------
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_MACOS_CLIENT_ID=

# --- Firebase: windows ------------------------------------------------------
FIREBASE_WINDOWS_API_KEY=
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_MEASUREMENT_ID=
